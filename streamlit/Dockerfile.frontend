FROM python:3.12-slim AS base

# Copy the uv binary from the official distroless uv image
COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /bin/uv

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# Copy only lockfile + pyproject first — install deps without the project itself,
# So this layer is cached and skipped on rebuilds unless dependencies change
COPY uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra frontend

COPY ./streamlit/front_end.py ./streamlit/front_end.py

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra frontend

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "streamlit/front_end.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]