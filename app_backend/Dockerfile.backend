FROM python:3.12-slim AS base

# Copy the uv binary from the official distroless uv image
COPY --from=ghcr.io/astral-sh/uv:0.11.24 /uv /bin/uv

WORKDIR /app

# Copy only lockfile + pyproject first — install deps without the project itself,
# So this layer is cached and skipped on rebuilds unless dependencies change
COPY uv.lock pyproject.toml ./
RUN uv sync --frozen --no-install-project --extra backend

# Copy the actual application code
COPY ./app_backend ./app_backend

# Install the project itself 
RUN uv sync --frozen --extra backend

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "app_backend.main:app", "--host", "0.0.0.0", "--port", "8000"]